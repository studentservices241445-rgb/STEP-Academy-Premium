          <span class="tag">توافق مع نمط قياس</span>
        </div>
      </div>
    </div>
  </div>
</header>

<main>
  <section class="container">
    <h2>📊 إحصائيات الدورة (محدّثة)</h2>
    <div class="stats">
      <div class="stat"><div class="big">+70</div><div class="cap">درس مسجّل</div></div>
      <div class="stat"><div class="big">+120</div><div class="cap">نموذج مكرّر محلول</div></div>
      <div class="stat"><div class="big">3</div><div class="cap">خطط مذاكرة جاهزة</div></div>
