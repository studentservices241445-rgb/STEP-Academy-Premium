              <defs>
                <linearGradient id="grad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#0fb37a"/><stop offset="100%" stop-color="#12d19a"/>
                </linearGradient>
              </defs>
            </svg>
            <strong class="pct" id="satPct">97%</strong>
            <small>نسبة رضا آخر 500 تقييم</small>
          </div>
        </div>
      </div>
      <div class="card">
        <h2>🎯 لماذا هذي الدورة؟</h2>
        <ul class="list">
          <li>شرح واضح للأقسام الأربعة: Grammar, Reading, Listening, Structure</li>
          <li>نماذج مكرّرة + ملف مختصر “ينقذك” لو وقتك ضيق</li>
