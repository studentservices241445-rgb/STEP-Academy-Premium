    <div class="hero-grid">
      <div class="card">
        <h2>⏳ العدّ التنازلي للدفعة الأقرب</h2>
        <div class="flex" style="margin-top:10px">
          <div class="countdown" id="countdown">
            <div class="timeBox"><div class="num" id="dd">00</div><div class="lbl">يوم</div></div>
            <div class="timeBox"><div class="num" id="hh">00</div><div class="lbl">ساعة</div></div>
