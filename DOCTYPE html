<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>STEP الشاملة الحديثة | النسخة V3</title>
<meta name="description" content="دورة STEP الشاملة الحديثة — تصميم فخم RTL، اشتراك مدى الحياة، خطط مذاكرة، نماذج مكررة، شروحات مسجلة، وتحديثات مستمرة.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0b1f17;              /* أخضر غامق بارد */
    --bg-2:#0f2a1f;
    --brand:#0fb37a;           /* أخضر سعودي أنيق */
    --brand-2:#12d19a;         /* أخضر متدرّج */
    --gold:#d6b56f;            /* ذهبي فاخر */
    --text:#e9f6f0;
    --muted:#b7ccc4;
    --card:#0d241b;
    --card-2:#133425;
    --danger:#ff6666;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:"Tajawal", system-ui, -apple-system, Segoe UI, Roboto, Arial}
  a{color:var(--gold);text-decoration:none}
  a:hover{opacity:.9}

  /* خلفية متحركة */
  .animated-bg{
    position:fixed;inset:0;overflow:hidden;z-index:-1;
    background:
      radial-gradient(1200px 600px at 80% -10%, rgba(18,209,154,.12), transparent 60%),
      radial-gradient(900px 500px at -10% 110%, rgba(15,179,122,.12), transparent 50%),
      linear-gradient(120deg, var(--bg) 0%, var(--bg-2) 100%);
  }
  .mesh{
    position:absolute;inset:-20vh -20vw;opacity:.07;filter:blur(40px);
    background:
      radial-gradient(800px 800px at 70% 20%, #1de9b6, transparent 60%),
      radial-gradient(900px 900px at 20% 60%, #00e676, transparent 60%),
      radial-gradient(700px 700px at 80% 80%, #64ffda, transparent 60%);
    animation:float 16s ease-in-out infinite alternate;
  }
  @keyframes float{to{transform:translate3d(2vw,-2vh,0)}}

  /* وسم مائي (علامة ملكية) */
  .watermark{
    position:fixed;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-9deg);
    font-size:9rem;font-weight:800;color:#ffffff10;pointer-events:none;white-space:nowrap;
  }

  /* شريط تقدم القراءة */
  .read-progress{
    position:fixed;top:0;right:0;height:4px;width:0;background:linear-gradient(90deg,var(--brand),var(--brand-2));
    box-shadow:0 0 12px #12d19a80;z-index:9999;transition:width .1s linear;
  }

  /* الحاويات */
  .container{max-width:1150px;margin:0 auto;padding:0 16px}
  .hero{
    position:relative;padding:64px 0 28px;border-bottom:1px solid #13634255;
  }
  .badge{
    display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;
    background:linear-gradient(90deg,#0f3a2a,#184e3a);color:#a9e2cd;border:1px solid #228b6544;font-weight:700;
  }
  .badge .dot{width:8px;height:8px;border-radius:50%;background:var(--brand-2);box-shadow:0 0 10px var(--brand-2)}
  h1{margin:14px 0 10px;font-size:2.2rem;line-height:1.35;letter-spacing:.3px}
  .sub{color:var(--muted);max-width:760px;font-size:1.05rem}

  .hero-grid{
    margin-top:28px;display:grid;grid-template-columns:1.1fr .9fr;gap:16px
  }
  .card{
    background:linear-gradient(180deg,var(--card),var(--card-2));
    border:1px solid #248f6750;border-radius:16px;padding:16px;
    box-shadow:0 10px 30px #00000040
  }

  /* عدادات أعلى الهيرو */
  .metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:18px}
  .metric{
    background:#0f2d22;border:1px solid #1e6247;border-radius:14px;padding:14px 12px;
  }
  .metric .kpi{font-size:1.45rem;font-weight:800;color:#dff9f0}
  .metric small{color:#9dc9bb}

  /* العد التنازلي + مؤشر الرضا */
  .flex{display:flex;gap:12px;flex-wrap:wrap}
  .countdown{
    flex:1;display:grid;grid-template-columns:repeat(4,1fr);gap:8px
  }
  .timeBox{background:#0f2d22;border:1px solid #1e6247;border-radius:12px;padding:12px;text-align:center}
  .timeBox .num{font-size:1.8rem;font-weight:800}
  .timeBox .lbl{color:#9dc9bb;font-size:.9rem}

  .gauge{
    width:180px;min-width:180px;height:180px;border-radius:16px;padding:14px;
    display:grid;place-items:center;background:#0f2d22;border:1px solid #1e6247;position:relative;overflow:hidden
  }
  .gauge svg{width:140px;height:140px}
  .gauge .pct{position:absolute;inset:auto 0 12px;display:block;text-align:center;font-weight:800;color:#eafff7}
  .gauge small{color:#9dc9bb}

  /* الإحصائيات */
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
  .stat{background:#0f2d22;border:1px solid #1e6247;border-radius:14px;padding:14px}
  .stat .big{font-size:1.6rem;font-weight:800}
  .stat .cap{color:#9dc9bb}

  /* أقسام المحتوى */
  section{padding:32px 0;border-bottom:1px dashed #1d6e51}
  h2{margin:0 0 14px;font-size:1.5rem}
  .lead{color:#cfe6dc}

  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .list{display:grid;gap:10px}
  .list li{background:#0f2d22;border:1px solid #1e6247;border-radius:12px;padding:12px;list-style:none}
  .tag{display:inline-block;padding:6px 10px;border-radius:999px;background:#114532;border:1px solid #1b6d52;color:#bdeada;font-size:.85rem}

  /* التوست (شهادات طلاب منبثقة) */
  .toast{
    position:fixed;left:16px;bottom:16px;background:#0f2d22;border:1px solid #1e6247;border-radius:12px;
    padding:12px 14px;max-width:320px;box-shadow:0 10px 30px #00000050;display:none;z-index:9998
  }
  .toast.show{display:block;animation:slideUp .4s ease}
  @keyframes slideUp{from{transform:translateY(15px);opacity:0}to{transform:none;opacity:1}}

  /* نموذج التسجيل */
  .form{
    display:grid;gap:12px;background:linear-gradient(180deg,#0e2a20,#123627);
    border:1px solid #1c6e51;border-radius:16px;padding:16px
  }
  .row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  label{font-weight:700;margin-bottom:6px;display:block}
  input,select,textarea{
    width:100%;padding:12px 12px;border-radius:12px;background:#0f2d22;border:1px solid #1e6247;color:#eafff7
  }
  textarea{min-height:110px;resize:vertical}
  .choices{display:flex;flex-wrap:wrap;gap:10px}
  .chip{display:inline-flex;gap:8px;align-items:center;padding:8px 12px;border-radius:999px;background:#0f2d22;border:1px solid #1e6247;cursor:pointer}
  .chip input{accent-color:var(--brand);transform:scale(1.1)}

  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:10px;
    background:linear-gradient(90deg,var(--brand),var(--brand-2));
    color:#05261a;font-weight:900;border:none;border-radius:12px;padding:14px 16px;font-size:1.05rem;cursor:pointer
  }
  .btn.gold{
    background:linear-gradient(90deg,#ddc28a,#f1d9a3);color:#3d2b05;border:1px solid #f1d9a3
  }
  .btn:active{transform:translateY(1px)}

  /* فوتر */
  footer{padding:38px 0;color:#bfe7db}
  .foot-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .mono{font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;font-size:.95rem}

  @media (max-width:980px){
    .hero-grid{grid-template-columns:1fr}
    .stats{grid-template-columns:1fr 1fr}
    .metrics{grid-template-columns:1fr 1fr}
    .grid-2{grid-template-columns:1fr}
    .gauge{margin-inline:auto}
  }
</style>
</head>
