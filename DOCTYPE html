<script>
  /* =================== متغيّرات قابلة للتعديل السريع =================== */
  const TELEGRAM_HANDLE = "Hilm_STEP1";                // حساب المنسّق (بدّله عند الحاجة)
  const PRICE_TEXT = "149 ر.س شامل الضريبة";          // السعر الظاهر للطلاب
  const COHORT_DATETIME = "2025-10-24T12:00:00";       // موعد الدفعة القادمة (ISO)
  const BASE_SUBS = 12842;                              // أساس عدّاد المشتركين
  const SATISFACTION = 0.97;                            // نسبة الرضا (0 - 1)
  /* ===================================================================== */

  // آخر تحديث (اليوم)
  const lastUpdateEl = document.getElementById('lastUpdate');
  const today = new Date();
  lastUpdateEl.textContent = today.toLocaleDateString('ar-SA', {year:'numeric', month:'long', day:'numeric'});

  // شريط تقدّم القراءة
  const readBar = document.getElementById('readBar');
  window.addEventListener('scroll', ()=>{
    const h = document.documentElement;
    const scrolled = (h.scrollTop) / (h.scrollHeight - h.clientHeight);
    readBar.style.width = (scrolled * 100) + '%';
  });

  // تعبئة شهور/سنوات
  const monthSel = document.getElementById('fMonth');
  const yearSel  = document.getElementById('fYear');
  const months = ["يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر"];
  months.forEach((m,i)=>{
    const o = document.createElement('option'); o.value = m; o.textContent = m; monthSel.appendChild(o);
  });
  const thisYear = new Date().getFullYear();
  for(let y=thisYear; y<=thisYear+2; y++){
    const o = document.createElement('option'); o.value = y; o.textContent = y; yearSel.appendChild(o);
  }

  // العدّ التنازلي
  const target = new Date(COHORT_DATETIME).getTime();
  const dd = document.getElementById('dd'), hh = document.getElementById('hh'), mm = document.getElementById('mm'), ss = document.getElementById('ss');
  function pad(n){return String(n).padStart(2,'0')}
  setInterval(()=>{
    const now = Date.now(); let diff = Math.max(0, target - now);
    const d = Math.floor(diff/(1000*60*60*24)); diff -= d*24*60*60*1000;
    const h = Math.floor(diff/(1000*60*60)); diff -= h*60*60*1000;
    const m = Math.floor(diff/(1000*60)); diff -= m*60*1000;
    const s = Math.floor(diff/1000);
    dd.textContent = pad(d); hh.textContent=pad(h); mm.textContent=pad(m); ss.textContent=pad(s);
  },1000);

  // مؤشر الرضا (قوس)
  const arc = document.getElementById('gArc');
  const pct = Math.round(SATISFACTION*100);
  const circumference = 2*Math.PI*42;            // r=42 => ~263.89
  const offset = circumference*(1 - SATISFACTION);
  arc.setAttribute('stroke-dasharray', circumference.toFixed(0));
  arc.setAttribute('stroke-dashoffset', offset.toFixed(0));
  document.getElementById('satPct').textContent = pct + "%";

  // عدّاد المشتركين (زيادة لطيفة)
  const subsKpi = document.getElementById('subsKpi');
  let subs = BASE_SUBS;
  const fmt = n=> n.toLocaleString('ar-SA');
  subsKpi.textContent = fmt(subs);
  setInterval(()=>{
    subs += Math.floor(Math.random()*3)+1; // +1..3
    subsKpi.textContent = fmt(subs);
  }, 15000 + Math.random()*10000);

  // شهادات (توست)
  const toast = document.getElementById('toast');
  const notes = [
    "نوف القحطاني: رفعت درجتي من 57 إلى 82 — ملف المختصر أنقذني 👏",
    "عبدالإله: النماذج فعلاً متكررة.. وصلت 90 خلال شهر 👍",
    "بيان: التنظيم والفهرسة ساعدتني أبدأ بدون تشتّت ✨",
    "مشاعل: دعم سريع وتحديثات مستمرة.. أحسن قرار اتخذته ✅"
  ];
  function showToast(msg){
    toast.textContent = "🗣️ " + msg;
    toast.classList.add('show');
    setTimeout(()=> toast.classList.remove('show'), 4300);
  }
  setTimeout(()=> showToast(notes[0]), 2500);
  setInterval(()=>{
    const m = notes[Math.floor(Math.random()*notes.length)];
    showToast(m);
  }, 22000);

  // بناء نص الطلب
  function getCheckedValues(selector){
    return [...document.querySelectorAll(selector)]
      .filter(i=>i.checked).map(i=>i.value);
  }
  function buildMessage(){
    const name = document.getElementById('fName').value.trim();
    const mail = document.getElementById('fMail').value.trim();
    const lvl  = (document.querySelector('input[name="lvl"]:checked')||{}).value || "";
    const target = document.getElementById('fTarget').value;
    const reason = document.getElementById('fReason').value;
    const month = document.getElementById('fMonth').value;
    const year  = document.getElementById('fYear').value;
    const note  = document.getElementById('fNote').value.trim();
    const pay   = (document.querySelector('input[name="pay"]:checked')||{}).value || "";
    const contact = getCheckedValues('.choices input[type="checkbox"]').join(" / ");

    return (
`اشتراك STEP — النسخة V3 (موقع رسمي)
الاسم: ${name}
البريد: ${mail || "—"}
المستوى الحالي: ${lvl || "—"}
الدرجة المستهدفة: ${target}
سبب الاختبار: ${reason}
موعد الاختبار: ${month || "—"} ${year || ""}
طريقة التواصل المفضلة: ${contact || "—"}
طريقة الدفع المفضلة: ${pay || "—"}
السعر المعروض: ${PRICE_TEXT}
ملاحظات: ${note || "—"}

أرجو تزويدي بطريقة الدفع المعتمدة لتأكيد اشتراكي وتفعيل الوصول الفوري.`
    );
  }

  // إرسال عبر تيليجرام ونسخ
  const form = document.getElementById('regForm');
  const copyBtn = document.getElementById('copyBtn');

  form.addEventListener('submit',(e)=>{
    e.preventDefault();
    const msg = encodeURIComponent(buildMessage());
    const contactLink = `https://t.me/${TELEGRAM_HANDLE}`;
    const shareUrl = `https://t.me/share/url?url=${encodeURIComponent(contactLink)}&text=${msg}`;
    window.open(shareUrl, "_blank");
  });

  copyBtn.addEventListener('click', async ()=>{
    const txt = buildMessage();
    try{ await navigator.clipboard.writeText(txt); copyBtn.textContent="تم النسخ ✅"; }
    catch{ copyBtn.textContent="انسخ يدويًا"; }
    setTimeout(()=> copyBtn.textContent="نسخ نص الطلب", 1800);
  });
</script>
</body>
</html>
